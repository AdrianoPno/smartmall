{
  "name": "smartmall",
  "version": "1.0.0",
  "description": "Projeto de estudo inspirado em vaga real (Ancar Ivanhoe), com foco em NestJS, arquitetura modular, Firebase Auth e boas práticas de desenvolvimento.",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^11.0.17",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.17",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.0.17",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase": "^11.6.0",
    "firebase-admin": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "eslint": "^9.24.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3"
  }
}
